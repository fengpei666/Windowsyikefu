<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 品牌色 -->
    <Color x:Key="BrandColor">#FF07C160</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="#FF06AD56" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8A8A8E" />
    <SolidColorBrush x:Key="TextOnBrandBrush" Color="#FFFFFFFF" />

    <!-- 面板 / 玻璃层 -->
    <SolidColorBrush x:Key="PanelBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ChatBackgroundBrush" Color="#99F2F2F7" />
    <SolidColorBrush x:Key="BubbleInBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BubbleOutBrush" Color="{StaticResource BrandColor}" />

    <!-- 分隔线 -->
    <SolidColorBrush x:Key="DividerBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2207C160" />

</ResourceDictionary>
