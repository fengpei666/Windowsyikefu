<Window x:Class="Windowsyikefu.Views.ForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="转发消息"
        Width="400" Height="540"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F3F5"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 半透明底：运行时开启系统毛玻璃后靠它透出来，和其它窗口保持一致 -->
    <Border Background="#33FFFFFF" BorderBrush="#22000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconLucide Kind="Forward" Width="15" Height="15"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="转发到会话" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Margin="0,6,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click">
                    <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </Grid>

            <!-- 内容预览 + 搜索 -->
            <StackPanel Grid.Row="1" Margin="18,4,18,12">
                <Border Background="#FFF7F8FA" CornerRadius="10" Padding="10,8"
                        BorderBrush="#FFE6E7EA" BorderThickness="1">
                    <TextBlock x:Name="TxtPreview" FontSize="12" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
                <TextBox x:Name="TxtSearch" Style="{StaticResource FlatTextBox}" MinHeight="36"
                         Margin="0,10,0,0" VerticalContentAlignment="Center"
                         ToolTip="按访客昵称或会话编号筛选"
                         TextChanged="TxtSearch_TextChanged" />
            </StackPanel>

            <!-- 会话列表 -->
            <Border Grid.Row="2" Margin="18,0,18,14" Background="White" CornerRadius="10"
                    BorderBrush="#FFE6E7EA" BorderThickness="1">
                <ListBox x:Name="ListSessions" Background="Transparent" BorderThickness="0"
                         Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListSessions_SelectionChanged"
                         MouseDoubleClick="ListSessions_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1,0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                                                Padding="0" SnapsToDevicePixels="True">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 用全局画刷，跟主窗口的会话项保持一致 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource SelectedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 头像：与左侧会话列表同一套规则（圆角矩形 + Clip 几何，否则裁不出圆角） -->
                                <Grid Grid.Column="0" Width="32" Height="32"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="#E4E8EF"
                                            Visibility="{Binding ShowAvatarText, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AvatarText}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#5A6474"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border CornerRadius="8"
                                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
                                        </Border.Clip>
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Margin="4,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding LastMsg}" FontSize="11" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 底部按钮栏：与设置窗口、其它弹窗统一 -->
            <Border Grid.Row="3" Background="#B3FFFFFF" BorderBrush="#14000000"
                    BorderThickness="0,1,0,0" Padding="20,10">
                <Grid>
                    <TextBlock x:Name="TxtHint" FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="180"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Width="76"
                                Click="Close_Click" />
                        <Button x:Name="BtnForward" Content="转发" Style="{StaticResource PrimaryButton}"
                                Width="96" Margin="10,0,0,0" Click="BtnForward_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
