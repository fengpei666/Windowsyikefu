<Window x:Class="Windowsyikefu.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Windowsyikefu.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="易客服" Width="1360" Height="860" MinWidth="880" MinHeight="560"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F5"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- 会话列表项 -->
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type vm:SessionItem}">
            <Grid Height="66" Background="Transparent">
                <!-- 右键会话项：先由 ItemContainerStyle 里的 PreviewMouseRightButtonDown 选中它，再弹菜单 -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                               RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="查看用户详情" Click="SessionShowUserInfo_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="UserRound" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制访客昵称" Click="SessionCopyName_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="ClipboardCopy" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制会话编号" Click="SessionCopyId_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="Hash" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="重新打开会话" Click="MenuReopenSession_Click"
                                  IsEnabled="{Binding CanReopen}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="RotateCcw" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="结束会话" Click="BtnCloseSession_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="CircleX" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 头像：有真实头像就显示图片；没有（未登录访客）显示空头像占位：方形 + 小圆角 -->
                <Grid Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="#E9ECF1"
                            BorderBrush="#DDE2EA" BorderThickness="1"
                            Visibility="{Binding ShowAvatarText, Converter={StaticResource BoolToVis}}">
                        <iconPacks:PackIconLucide Kind="UserRound" Width="20" Height="20"
                                                  Foreground="#A9B2C0"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!--
                        真实头像：圆角矩形。
                        注意 WPF 的 Border.CornerRadius 不会裁剪子元素（ClipToBounds 只按矩形裁），
                        必须再给一层 Clip 几何，否则图片四角会把圆角盖成方的。
                    -->
                    <Border CornerRadius="10" ClipToBounds="True"
                            Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,38,38" RadiusX="10" RadiusY="10" />
                        </Border.Clip>
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>

                    <!-- 访客在线小绿点：切走页面或退出后服务端心跳停止，会自动变灰 -->
                    <Ellipse Width="10" Height="10" Fill="#FF07C160"
                             Stroke="White" StrokeThickness="1.5"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Visibility="{Binding IsUserOnline, Converter={StaticResource BoolToVis}}" />

                    <!--
                        未读角标：贴在头像右上角，直接把未读条数写在上面（超过 99 显示 99+），
                        不用看右侧的小徽标也知道这个访客攒了几条没回。
                    -->
                    <Border MinWidth="16" Height="16" CornerRadius="8" Background="#FFFA5151"
                            Padding="4,0" Margin="0,-4,-4,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UnreadText}" FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border x:Name="StatusChip" Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                                Background="#1A000000" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#777777" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding LastMsg}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                            Margin="0,0,14,0">
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#AAAAAA"
                               HorizontalAlignment="Right" />
                    <Border Background="#FA5151" CornerRadius="9" MinWidth="18" Height="18"
                            Margin="0,6,0,0" Padding="5,0" HorizontalAlignment="Right"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding UnreadText}" FontSize="11" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="0">
                    <Setter TargetName="StatusChip" Property="Background" Value="#26FF9F0A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="2">
                    <Setter TargetName="StatusChip" Property="Background" Value="#1A000000" />
                    <Setter TargetName="StatusChip" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            卡片上的小按钮：悬停时底色渐变到品牌绿 + 轻微上浮，点击有按下反馈，
            用动画而不是硬切色值，点起来更「丝滑」。
        -->
        <Style x:Key="BubbleCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <SolidColorBrush Color="#0F000000" />
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="shift" Y="0" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrandHoverBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#2407C160" Duration="0:0:0.16" />
                                            <DoubleAnimation Storyboard.TargetName="shift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation
                                                Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#0F000000" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="shift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="shift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            气泡内容：文本 / 图片 / 订单卡片 / 红包卡片。
            访客气泡与客服气泡共用这一套，避免同样的渲染逻辑写两遍。
        -->
        <DataTemplate x:Key="BubbleContentTemplate" DataType="{x:Type vm:MessageItem}">
            <StackPanel>
                <!-- 文本 -->
                <TextBlock x:Name="PartText" Text="{Binding Content}" FontSize="13.5" LineHeight="21"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{Binding BubbleForeground}" />

                <!-- 图片 -->
                <Border x:Name="PartImage" Visibility="Collapsed" CornerRadius="8"
                        ClipToBounds="True">
                    <Image Source="{Binding Image}" MaxWidth="240" MaxHeight="240"
                           Stretch="Uniform" Cursor="Hand"
                           MouseLeftButtonUp="MessageImage_Click" />
                </Border>

                <!--
                    订单卡片：订单号 / 商品 / 金额 / 状态 / 下单时间 / 买家 全都摆在卡片上，
                    宽度固定，值一律单行省略号截断，长时间戳、长订单号、长链接都撑不破卡片。
                -->
                <Border x:Name="PartOrder" Visibility="Collapsed" Width="264"
                        Background="#FFF7F8FA" BorderBrush="#1A000000" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <!-- 头部：图标 + 标题 + 金额 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconLucide Kind="Package" Width="15" Height="15"
                                                      Foreground="{StaticResource BrandHoverBrush}"
                                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="订单卡片" FontSize="12.5" FontWeight="SemiBold"
                                       Margin="6,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding OrderAmount}" FontSize="15"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderAmount}"
                                       Foreground="#E06C1F" />
                        </Grid>

                        <Border Height="1" Background="#14000000" Margin="0,9,0,8" />

                        <!-- 明细行：标签固定宽度，值单行省略号 -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="订单号" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8A8F99" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderNo}" FontSize="11.5"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderNo}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="商品" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8A8F99" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderTitle}" FontSize="11.5"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderTitle}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="状态" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8A8F99" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderStatus}" FontSize="11.5"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderStatus}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="下单" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8A8F99" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderTime}" FontSize="11.5"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderTime}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <!-- 买家信息没有就不占位 -->
                        <Grid x:Name="OrderBuyerRow" Margin="0,0,0,5"
                              Visibility="{Binding HasOrderBuyer, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="买家" FontSize="11" VerticalAlignment="Center"
                                       Foreground="#8A8F99" />
                            <TextBlock Grid.Column="1" Text="{Binding OrderBuyer}" FontSize="11.5"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OrderBuyer}"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Button Content="查看详情" Style="{StaticResource BubbleCardButton}"
                                    Click="OrderDetail_Click" />
                            <Button Content="退款" Style="{StaticResource BubbleCardButton}"
                                    Click="OrderRefund_Click" />
                            <Button Content="补单" Style="{StaticResource BubbleCardButton}"
                                    Click="OrderReorder_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 红包卡片 -->
                <Border x:Name="PartRedpack" Visibility="Collapsed" Width="264"
                        Background="#FFF7F8FA" BorderBrush="#1A000000" BorderThickness="1"
                        CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Wallet" Width="15" Height="15"
                                                      Foreground="#E06C1F" VerticalAlignment="Center" />
                            <TextBlock Text="红包" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock x:Name="RedpackStatusLine" FontSize="12" Margin="0,8,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="#8A8F99" />

                        <Button x:Name="BtnReceiveRedpack" Content="领取红包" Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource BubbleCardButton}"
                                Click="RedpackReceive_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Text">
                    <Setter TargetName="PartText" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="PartImage" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Order">
                    <Setter TargetName="PartOrder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Redpack">
                    <Setter TargetName="PartRedpack" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RedpackStatusLine" Property="Text"
                            Value="{Binding RedpackStatusText, StringFormat=状态：{0}}" />
                    <Setter TargetName="BtnReceiveRedpack" Property="Visibility"
                            Value="{Binding CanReceiveRedpack, Converter={StaticResource BoolToVis}}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            气泡下方的元信息：时间 + 送达状态。
            从气泡内容里独立出来，这样图片 / 红包 / 订单卡片不带外层气泡时，
            时间依然能稳定贴在内容下方，而不是被压在卡片里。
        -->
        <DataTemplate x:Key="MessageMetaTemplate" DataType="{x:Type vm:MessageItem}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TimeText}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!-- 单勾：已送达服务器（访客尚未读） -->
                <iconPacks:PackIconLucide x:Name="ReceiptSingle" Kind="Check"
                                          Width="13" Height="13" Margin="5,0,0,0"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          VerticalAlignment="Center" />

                <!-- 双勾：访客已读，切换时从左端弹出 -->
                <iconPacks:PackIconLucide x:Name="ReceiptDouble" Kind="CheckCheck"
                                          Width="17" Height="17" Margin="2,0,0,0"
                                          Foreground="{StaticResource BrandBrush}" Opacity="0"
                                          Visibility="Collapsed"
                                          RenderTransformOrigin="0,0.5"
                                          VerticalAlignment="Center">
                    <iconPacks:PackIconLucide.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </iconPacks:PackIconLucide.RenderTransform>
                </iconPacks:PackIconLucide>
            </StackPanel>

            <DataTemplate.Triggers>
                <!-- 访客已读：单勾收起，双勾从左端弹出 -->
                <DataTrigger Binding="{Binding IsRead}" Value="True">
                    <Setter TargetName="ReceiptSingle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ReceiptDouble" Property="Visibility" Value="Visible" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ReceiptDouble"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetName="ReceiptDouble"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.2" To="1" Duration="0:0:0.32">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.55" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ReceiptDouble"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.5" To="1" Duration="0:0:0.26">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.35" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>

                <!-- 放在最后：访客消息不显示送达状态 -->
                <DataTrigger Binding="{Binding IsMine}" Value="False">
                    <Setter TargetName="ReceiptSingle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ReceiptDouble" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 消息气泡 -->
        <!-- 注意：气泡必须放在有宽度约束的 Grid 列里，否则 TextWrapping 失效会导致长消息横向溢出 -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageItem}">
            <Grid Margin="0,5">
                <!--
                    右键菜单挂在整行上（含气泡外的空白），右键任意位置都能呼出。
                    ContextMenu 不在可视树上，DataContext 要显式从 PlacementTarget 取，
                    否则菜单里的 {Binding} 会拿不到当前这条消息。
                -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                               RelativeSource={RelativeSource Self}}">
                        <!-- 复制什么，按消息类型决定，用不到的项直接不显示 -->
                        <MenuItem Header="复制文本" Click="MsgCopyText_Click"
                                  Visibility="{Binding CanCopyText, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="ClipboardCopy" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制订单号" Click="MsgCopyOrderNo_Click"
                                  Visibility="{Binding CanCopyOrderNo, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="ClipboardCopy" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="复制图片" Click="MsgCopyImage_Click"
                                  Visibility="{Binding CanCopyImage, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="Image" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="图片另存为…" Click="MsgSaveImage_Click"
                                  Visibility="{Binding CanCopyImage, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="Download" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="用系统看图程序打开" Click="MsgOpenImage_Click"
                                  Visibility="{Binding CanCopyImage, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="ExternalLink" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <MenuItem Header="引用" Click="MsgQuote_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="Quote" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="转发到其它会话…" Click="MsgForward_Click"
                                  Visibility="{Binding CanForward, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconLucide Kind="Forward" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- 对方（访客）消息 -->
                <Grid x:Name="LeftRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 访客消息的头像：有真实头像就用图，没有退回「客」字占位 -->
                    <Grid Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="#E4E8EF"
                                Visibility="{Binding ShowAvatarText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AvatarText}" FontSize="13" Foreground="#5A6474"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- 配 Clip 几何，圆角才真的裁得出来 -->
                        <Border CornerRadius="10"
                                Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,34,34" RadiusX="10" RadiusY="10" />
                            </Border.Clip>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>

                    <!-- 气泡 + 下方时间：时间放在气泡外面，才不会被卡片挤在里面 -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="9,0,0,0">
                        <Border x:Name="LeftBubble" HorizontalAlignment="Left" MaxWidth="480"
                                Background="White" CornerRadius="3,12,12,12" Padding="13,10"
                                BorderBrush="#12000000" BorderThickness="1">
                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource BubbleContentTemplate}" />
                        </Border>
                        <ContentPresenter Content="{Binding}" HorizontalAlignment="Left"
                                          Margin="2,5,0,0"
                                          ContentTemplate="{StaticResource MessageMetaTemplate}" />
                    </StackPanel>
                </Grid>

                <!-- 自己（客服）消息 -->
                <Grid x:Name="RightRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,9,0">
                        <Border x:Name="RightBubble" HorizontalAlignment="Right" MaxWidth="480"
                                Background="{StaticResource BrandBrush}" CornerRadius="12,3,12,12"
                                Padding="13,10">
                            <ContentPresenter Content="{Binding}"
                                              ContentTemplate="{StaticResource BubbleContentTemplate}" />
                        </Border>
                        <ContentPresenter Content="{Binding}" HorizontalAlignment="Right"
                                          Margin="0,5,2,0"
                                          ContentTemplate="{StaticResource MessageMetaTemplate}" />
                    </StackPanel>

                    <!-- 自己的消息：优先显示客服自己的头像，没有就用「我」字占位 -->
                    <Grid Grid.Column="1" Width="34" Height="34" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="#D6F2E3"
                                Visibility="{Binding ShowAvatarText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AvatarText}" FontSize="13"
                                       Foreground="{StaticResource BrandHoverBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border CornerRadius="10"
                                Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVis}}">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,34,34" RadiusX="10" RadiusY="10" />
                            </Border.Clip>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- 系统消息 -->
                <Border x:Name="SystemRow" Visibility="Collapsed" HorizontalAlignment="Center"
                        Background="#33000000" CornerRadius="4" Padding="10,4" MaxWidth="480">
                    <TextBlock Text="{Binding Content}" FontSize="11" Foreground="White"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                    <Setter TargetName="LeftRow" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RightRow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSystem}" Value="True">
                    <Setter TargetName="LeftRow" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RightRow" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SystemRow" Property="Visibility" Value="Visible" />
                </DataTrigger>

                <!-- 图片 / 红包 / 订单卡片：内容自己带底色和圆角，不再套一层绿气泡，直接发出去 -->
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="LeftBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="LeftBubble" Property="BorderThickness" Value="0" />
                    <Setter TargetName="LeftBubble" Property="Padding" Value="0" />
                    <Setter TargetName="RightBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="RightBubble" Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Redpack">
                    <Setter TargetName="LeftBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="LeftBubble" Property="BorderThickness" Value="0" />
                    <Setter TargetName="LeftBubble" Property="Padding" Value="0" />
                    <Setter TargetName="RightBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="RightBubble" Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Order">
                    <Setter TargetName="LeftBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="LeftBubble" Property="BorderThickness" Value="0" />
                    <Setter TargetName="LeftBubble" Property="Padding" Value="0" />
                    <Setter TargetName="RightBubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="RightBubble" Property="Padding" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <!--
        整窗铺毛玻璃：这层只是一层薄薄的提亮（透出下面的系统材质，
        用 Acrylic 时能明显看到窗口后面的内容被模糊掉），顶部玻璃条放窗口按钮，内容区被它包住一圈。
    -->
    <Border Background="#33FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                顶部毛玻璃条上的站点标签：绑了几个站点就有几个标签，点标签切换站点。
                右侧固定留出 150px 给窗口按钮（3 × 46 + 10），标签再多也只在条内横向滚动，
                绝对不会盖到最小化 / 关闭按钮上。
            -->
            <Grid Grid.Row="0" Margin="10,0,150,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  PreviewMouseLeftButtonDown="WindowDrag_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="WindowDrag_PreviewMouseMove">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly">
                    <ItemsControl x:Name="ListSiteTabs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SiteTabItem}">
                                <Border x:Name="TabBg" CornerRadius="8" Padding="10,4" Margin="0,0,6,0"
                                        Background="#14000000" Cursor="Hand"
                                        MouseLeftButtonUp="SiteTab_Click"
                                        ToolTip="{Binding Name}">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                                                   RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="刷新此站点" Click="SiteTabRefresh_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="RefreshCw" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="移除此站点" Click="SiteTabRemove_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="Trash2" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TabText" Text="{Binding Name}" FontSize="11.5"
                                                   MaxWidth="120" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <!-- 该站点的未读数：未读时显示小红角标，直接标出有几条 -->
                                        <Border MinWidth="15" Height="15" CornerRadius="7.5" Margin="5,0,0,0"
                                                Padding="4,0" Background="#FFFA5151" VerticalAlignment="Center"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding UnreadText}" FontSize="9.5" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- 鼠标悬停：浅一点，能看出可点 -->
                                    <Trigger SourceName="TabBg" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBg" Property="Background" Value="#26FFFFFF" />
                                    </Trigger>

                                    <!-- 当前正在看的站点：白底 + 深色字，一眼能认出来 -->
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBg" Property="Background" Value="#F2FFFFFF" />
                                        <Setter TargetName="TabText" Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                        <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 再绑一个站点：流程和首次绑定一样，结果追加成新标签 -->
                <Button Grid.Column="1" x:Name="BtnAddSite" Width="26" Height="26" Margin="0,0,6,0"
                        Style="{StaticResource CaptionButton}" Click="BtnAddSite_Click"
                        ToolTip="绑定新的网站（再开一个标签页）">
                    <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14"
                                              Foreground="{StaticResource BrandHoverBrush}" />
                </Button>
            </Grid>

            <!-- 顶部毛玻璃条：窗口控制按钮 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}"
                        Height="36" Click="BtnMin_Click" ToolTip="最小化">
                    <iconPacks:PackIconLucide Kind="Minus" Width="14" Height="14" />
                </Button>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                        Height="36" Click="BtnMax_Click" ToolTip="最大化/还原">
                    <iconPacks:PackIconLucide x:Name="IconMax" Kind="Square" Width="12" Height="12" />
                </Button>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                        Height="36" Click="BtnClose_Click"
                        ToolTip="关闭到托盘（继续接收消息）">
                    <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                ==================== 最左：头像列（与顶部毛玻璃连成一体） ====================
                整条都能拖着窗口走：按下后真有位移才 DragMove，
                所以点在线开关、点底部按钮不会被抢走（原地松开还是点击）。
            -->
            <Grid Grid.Column="0" Background="Transparent"
                  PreviewMouseLeftButtonDown="WindowDrag_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="WindowDrag_PreviewMouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    头像：优先显示客服自己的真实头像（kefuInfo.avatar），
                    拿不到头像图标时回退到应用图标，右下角小点跟随在线开关。
                -->
                <Grid Grid.Row="0" Width="42" Height="42" HorizontalAlignment="Center"
                      Margin="0,8,0,0">
                    <Border CornerRadius="12" Background="#E4E8EF">
                        <Image x:Name="TitleIcon" Width="26" Height="26" />
                    </Border>

                    <Grid x:Name="KefuAvatarBox" Visibility="Collapsed">
                        <!-- 同样要配 Clip 几何，否则客服头像的四角是方的 -->
                        <Border CornerRadius="12" ClipToBounds="True">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,42,42" RadiusX="12" RadiusY="12" />
                            </Border.Clip>
                            <Image x:Name="KefuAvatar" Stretch="UniformToFill" />
                        </Border>
                        <Ellipse x:Name="KefuOnlineDot" Width="11" Height="11"
                                 Fill="#FF07C160" Stroke="White" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>

                <!-- 应用名 -->
                <TextBlock Grid.Row="1" Text="易客服" FontSize="10" Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />

                <!--
                    在线开关（头像下方）：点一下在线、再点一下离线，
                    走的是服务端 setOnline 接口，切换的是"客服身份是否在线"。
                -->
                <StackPanel Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <CheckBox x:Name="ChkOnline" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Center" Click="ChkOnline_Click"
                              ToolTip="当前在线 · 点击下线" />
                    <TextBlock x:Name="TxtOnlineState" Text="在线" FontSize="9" Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrandHoverBrush}" />
                </StackPanel>

                <!-- 连接状态 -->
                <TextBlock x:Name="TxtConnStatus" Grid.Row="3" Text="未连接" FontSize="9"
                           HorizontalAlignment="Center" Margin="0,0,0,10"
                           Foreground="{StaticResource BrandHoverBrush}" />

                <!-- 底部操作 -->
                <StackPanel Grid.Row="4" Margin="0,0,0,14">
                    <Button x:Name="BtnRefresh" Style="{StaticResource CaptionButton}"
                            Height="34" Click="BtnRefresh_Click" ToolTip="刷新会话列表">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="BtnPin" Style="{StaticResource CaptionButton}"
                            Height="34" Click="BtnPin_Click" ToolTip="窗口置顶">
                        <iconPacks:PackIconLucide Kind="Pin" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="BtnSettings" Style="{StaticResource CaptionButton}"
                            Height="34" Click="BtnSettings_Click" ToolTip="设置">
                        <iconPacks:PackIconLucide Kind="Settings" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                ==================== 中间：会话列表列 ====================
                和右边聊天列贴在一起、共同构成一整块嵌入面板：
                所以只有左侧两角是圆的，右侧是与聊天列相接的直角（中间用一条分隔线区分）。
                圆角靠 SizeChanged 里设的 Clip 几何才裁得出来，Border 自己的 CornerRadius 不裁子元素。
            -->
            <Border Grid.Column="1" Background="#D9F2F2F2" CornerRadius="10,0,0,10"
                    ClipToBounds="True" SizeChanged="PanelCornerClip">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 搜索框与会话列表之间的分隔线 -->
                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource DividerBrush}" />

                    <!-- 搜索 -->
                    <Grid Grid.Row="0" Margin="12,0,12,0"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Height="34" CornerRadius="6" Background="#FFE4E4E6"
                                VerticalAlignment="Center">
                            <Grid>
                                <iconPacks:PackIconLucide Kind="Search" Width="14" Height="14"
                                                          Foreground="#FF8A8A8E"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left" Margin="10,0,0,0" />
                                <TextBlock x:Name="TxtSearchHint" Text="搜索" FontSize="12"
                                           Foreground="#FF9A9A9E" VerticalAlignment="Center"
                                           Margin="30,0,0,0" IsHitTestVisible="False" />
                                <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                                         FontSize="12" Margin="30,0,8,0" VerticalContentAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ListBox x:Name="ListSessions" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemTemplate="{StaticResource SessionTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ListSessions_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="8,1,8,1" />
                                <!-- 右键即选中：菜单里的操作都作用于当前会话，必须先选上 -->
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="SessionItem_PreviewMouseRightButtonDown" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="bd" CornerRadius="8" Background="Transparent"
                                                        Padding="0" SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>

                                                <!-- 会话之间的分隔线：放在上层，鼠标划过时也不会被底色盖掉 -->
                                                <Border Height="1" VerticalAlignment="Bottom"
                                                        Background="{StaticResource DividerBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14000000" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#2207C160" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

                <!--
                    右侧：聊天列。与会话列表紧贴成一块完整的嵌入面板，
                    所以只有右侧两角是圆的，左侧用一条分隔线跟列表分开。
                -->
                <Border Grid.Column="2" Background="#E6F5F6F7" CornerRadius="0,10,10,0"
                        ClipToBounds="True" SizeChanged="PanelCornerClip">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 会话列表与聊天区之间的分隔线（放在这边，不会被列表的滚动条压住） -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Width="1" HorizontalAlignment="Left"
                            Background="{StaticResource DividerBrush}" />

                    <!-- 会话头部 -->
                    <Border Grid.Row="0" Background="#FFF2F2F2" BorderBrush="#FFE2E2E4"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock x:Name="TxtChatTitle" Text="未选择会话" FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtChatSub" Text="从左侧选择一个会话开始" FontSize="11"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- 右侧：更多菜单 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="BtnMore" Style="{StaticResource CaptionButton}"
                                        Height="58" Click="BtnMore_Click" ToolTip="更多">
                                    <iconPacks:PackIconLucide Kind="Ellipsis" Width="17" Height="17" />
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ChatMenu">
                                            <MenuItem Header="用户详情" Click="MenuUserInfo_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="UserRound"
                                                                              Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="发送订单卡片…" Click="MenuSendOrder_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="Package"
                                                                              Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="发红包…" Click="MenuSendRedpack_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="Wallet"
                                                                              Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem x:Name="MenuReopenSession" Header="重新打开会话"
                                                      Click="MenuReopenSession_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="RotateCcw"
                                                                              Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="结束会话" Click="BtnCloseSession_Click">
                                                <MenuItem.Icon>
                                                    <iconPacks:PackIconLucide Kind="CircleX"
                                                                              Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 消息列表 -->
                    <!-- HorizontalScrollBarVisibility=Disabled 会把内容宽度锁定为视口宽度，是防溢出的关键 -->
                    <Grid Grid.Row="1" ClipToBounds="True">
                        <ScrollViewer x:Name="ScrollMessages"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="20,12,20,12">
                            <ItemsControl x:Name="ListMessages"
                                          ItemTemplate="{StaticResource MessageTemplate}" />
                        </ScrollViewer>

                        <!-- 未选择会话时的空状态 -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" IsHitTestVisible="False">
                            <iconPacks:PackIconLucide Kind="MessagesSquare" Width="46" Height="46"
                                                      Foreground="#33000000" HorizontalAlignment="Center" />
                            <TextBlock Text="选择左侧会话开始回复" FontSize="13" Margin="0,14,0,0"
                                       Foreground="#99000000" HorizontalAlignment="Center" />
                            <TextBlock Text="关闭窗口后程序会留在托盘，继续接收新消息"
                                       FontSize="11" Margin="0,6,0,0"
                                       Foreground="#66000000" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 用户详情面板（从右侧滑入） -->
                        <Border x:Name="UserInfoPanel" Width="272" HorizontalAlignment="Right"
                                Background="#FFFFFFFF" BorderBrush="#FFE2E2E4"
                                BorderThickness="1,0,0,0" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="UserInfoShift" X="272" />
                            </Border.RenderTransform>

                            <StackPanel Margin="22,26,22,22">
                                <!-- 头像：有真实头像显示图片，否则回退空头像占位（方形 + 小圆角） -->
                                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                    <Border x:Name="InfoAvatarBox" CornerRadius="16" Background="#E9ECF1"
                                            BorderBrush="#DDE2EA" BorderThickness="1">
                                        <iconPacks:PackIconLucide Kind="UserRound" Width="30" Height="30"
                                                                  Foreground="#A9B2C0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 真实头像：与占位同款圆角矩形，靠 Clip 几何真正裁出来 -->
                                    <Border x:Name="InfoAvatarImageBox" CornerRadius="16"
                                            ClipToBounds="True" Visibility="Collapsed">
                                        <Border.Clip>
                                            <RectangleGeometry Rect="0,0,64,64" RadiusX="16" RadiusY="16" />
                                        </Border.Clip>
                                        <Image x:Name="InfoAvatarImage" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="InfoTitle" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="InfoStatus" FontSize="11" HorizontalAlignment="Center"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <Border Height="1" Background="#FFEDEDEF" Margin="0,18,0,18" />

                                <TextBlock Text="会话编号" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InfoId" FontSize="12" Margin="0,4,0,14"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Text="最后一条消息" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InfoLastMsg" FontSize="12" Margin="0,4,0,14"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Text="最后活跃" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InfoLastTime" FontSize="12" Margin="0,4,0,14"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Text="访客状态" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InfoVisitorState" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <Button x:Name="BtnFullUserInfo" Content="查看完整资料"
                                        Style="{StaticResource GhostButton}" Height="32"
                                        HorizontalAlignment="Left" Margin="0,20,0,0"
                                        Click="BtnFullUserInfo_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 快捷回复：默认只占一行，右侧按钮展开后可看全部 -->
                    <Border x:Name="QuickReplyBar" Grid.Row="2" Background="#FFF2F2F2"
                            Padding="16,8,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 折叠靠这里裁掉多余的行；展开时高度放开为 Auto -->
                            <Grid x:Name="QuickClip" Grid.Column="0" Height="34"
                                  ClipToBounds="True" VerticalAlignment="Top"
                                  SizeChanged="QuickClip_SizeChanged">
                                <ItemsControl x:Name="ListQuickReplies" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource QuickReplyChip}"
                                                    Content="{Binding}" Click="QuickReply_Click" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- 候选词超过一行才出现 -->
                            <Button x:Name="BtnQuickToggle" Grid.Column="1" Width="26" Height="26"
                                    Margin="0,0,6,0" VerticalAlignment="Top" Visibility="Collapsed"
                                    Style="{StaticResource CaptionButton}" ToolTip="展开全部快捷回复"
                                    Click="BtnQuickToggle_Click">
                                <iconPacks:PackIconLucide x:Name="IconQuickToggle" Kind="ChevronDown"
                                                          Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 输入区 -->
                    <Border x:Name="InputBar" Grid.Row="3" Background="#FFF7F8FA"
                            BorderBrush="#FFE6E7EA" BorderThickness="0,1,0,0" Padding="18,14,18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border CornerRadius="12" Background="White" BorderBrush="#FFE6E7EA"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1A2A35" BlurRadius="18" ShadowDepth="2"
                                                      Direction="270" Opacity="0.10" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 文本区 -->
                                    <Grid Grid.Row="0">
                                        <TextBox x:Name="TxtInput" MinHeight="84" MaxHeight="160"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="Transparent" BorderThickness="0"
                                                 FontSize="13" Padding="16,12"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 PreviewKeyDown="TxtInput_PreviewKeyDown"
                                                 TextChanged="TxtInput_TextChanged" />
                                        <TextBlock x:Name="TxtInputHint"
                                                   Text="输入消息，Enter 发送 · Shift+Enter 换行"
                                                   FontSize="13" Foreground="#B9BBC2"
                                                   Margin="18,12,0,0" VerticalAlignment="Top"
                                                   IsHitTestVisible="False" />
                                    </Grid>

                                    <!-- 底部工具栏：只保留真实功能 -->
                                    <Grid Grid.Row="1" Margin="14,4,12,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnPickImage" Style="{StaticResource CaptionButton}"
                                                    Width="30" Height="28" Margin="0,0,5,0"
                                                    ToolTip="发送图片" Click="BtnPickImage_Click">
                                                <iconPacks:PackIconLucide Kind="ImagePlus" Width="16" Height="16" />
                                            </Button>
                                            <Button x:Name="BtnSendOrder" Style="{StaticResource CaptionButton}"
                                                    Width="30" Height="28" Margin="0,0,5,0"
                                                    ToolTip="发送订单卡片" Click="MenuSendOrder_Click">
                                                <iconPacks:PackIconLucide Kind="Package" Width="16" Height="16" />
                                            </Button>
                                            <Button x:Name="BtnSendRedpack" Style="{StaticResource CaptionButton}"
                                                    Width="30" Height="28" Margin="0,0,5,0"
                                                    ToolTip="发红包" Click="MenuSendRedpack_Click">
                                                <iconPacks:PackIconLucide Kind="Wallet" Width="16" Height="16" />
                                            </Button>
                                            <TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="BtnSend" Content="发送" Style="{StaticResource PrimaryButton}"
                                                Height="34" MinWidth="76" HorizontalAlignment="Right"
                                                Click="BtnSend_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
