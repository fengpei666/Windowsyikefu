<Window x:Class="Windowsyikefu.Views.BindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="易客服 - 绑定客服账号"
        Width="520" Height="470"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF3F3F5"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 半透明底：运行时会开启系统毛玻璃，靠它透出来（失败则退回不透明浅灰） -->
    <Border Background="#33FFFFFF" BorderBrush="#22000000" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="易客服" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="· 绑定客服账号" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Margin="0,6,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="BtnClose_Click">
                    <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Padding="28,4,28,18">
                <StackPanel>
                    <TextBlock Text="输入后台「APP 接入管理」生成的凭证" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,18" />

                    <TextBlock Text="接口地址" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtApiUrl" Style="{StaticResource FlatTextBox}" MinHeight="40"
                             Margin="0,0,0,14" />

                    <TextBlock Text="APP ID" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtAppId" Style="{StaticResource FlatTextBox}" MinHeight="40"
                             Margin="0,0,0,14" />

                    <TextBlock Text="APP Secret" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox x:Name="TxtAppSecret" Style="{StaticResource FlatTextBox}" MinHeight="40"
                             Margin="0,0,0,16" />

                    <TextBlock x:Name="TxtStatus" FontSize="12" Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="提示：在后台绑定页点「打开桌面端」可一键唤起并自动绑定；也可复制 easykefu://bind?api_url=...&amp;app_id=...&amp;app_secret=... 链接后点「粘贴 Deep Link」手动填充。" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮栏：与设置窗口、其它弹窗统一 -->
            <Border Grid.Row="2" Background="#B3FFFFFF" BorderBrush="#14000000"
                    BorderThickness="0,1,0,0" Padding="22,12">
                <Grid>
                    <Button x:Name="BtnPaste" Content="粘贴 Deep Link" Style="{StaticResource GhostButton}"
                            Width="128" HorizontalAlignment="Left" Click="BtnPaste_Click" />
                    <Button x:Name="BtnBind" Content="测试连接并绑定" Style="{StaticResource PrimaryButton}"
                            Width="148" HorizontalAlignment="Right" Click="BtnBind_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
