<Window x:Class="Windowsyikefu.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="版本更新"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFF3F3F5"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 半透明底：运行时开启系统毛玻璃后靠它透出来，和其它窗口保持一致 -->
    <Border x:Name="Root" Background="#33FFFFFF" BorderBrush="#22000000" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <iconPacks:PackIconLucide Kind="Download" Width="15" Height="15"
                                              Foreground="{StaticResource BrandBrush}"
                                              VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="TxtTitle" FontSize="13.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                        HorizontalAlignment="Right" Margin="0,6,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Later_Click">
                    <iconPacks:PackIconLucide Kind="X" Width="14" Height="14" />
                </Button>
            </Grid>

            <Border Height="1" Background="#FFE6E7EA" />

            <!-- 版本对比：当前 → 最新 -->
            <StackPanel Orientation="Horizontal" Margin="24,18,24,0">
                <Border Background="#14000000" CornerRadius="6" Padding="11,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtCurrent" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <iconPacks:PackIconLucide Kind="ArrowRight" Width="14" Height="14" Margin="10,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource TextSecondaryBrush}" />

                <Border Background="#1A07C160" CornerRadius="6" Padding="11,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="最新" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Name="TxtLatest" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 强制更新提示：只在强制更新时出现 -->
            <Border x:Name="BoxForce" Visibility="Collapsed" Margin="24,14,24,0"
                    Background="#1FFFB020" CornerRadius="6" Padding="12,9">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Info" Width="14" Height="14" Margin="0,1,8,0"
                                              VerticalAlignment="Top" Foreground="#FF9A6B00" />
                    <TextBlock Text="本次为强制更新，需下载安装后才能继续使用。"
                               FontSize="11.5" TextWrapping="Wrap" MaxWidth="380"
                               Foreground="#FF8A6100" />
                </StackPanel>
            </Border>

            <!-- 更新内容 / 下载进度：两块占同一个位置，按状态切换 -->
            <Grid Margin="24,16,24,0">
                <StackPanel x:Name="PanelLog">
                    <TextBlock Text="更新内容" FontSize="11.5" Margin="0,0,0,8"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LogBody" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,14,0,18">
                    <TextBlock x:Name="TxtProgress" Text="正在下载新版本…" FontSize="12.5"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <ProgressBar x:Name="BarProgress" Height="4" Margin="0,16,0,0"
                                 Maximum="100" Value="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="#1F000000" CornerRadius="2" />
                                    <Border x:Name="PART_Indicator" Background="{StaticResource BrandBrush}"
                                            CornerRadius="2" HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock x:Name="TxtProgressDetail" FontSize="11" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 底部操作栏：与设置窗口、其它弹窗统一 -->
            <Border Background="#B3FFFFFF" BorderBrush="#14000000" BorderThickness="0,1,0,0"
                    Padding="24,12" Margin="0,18,0,0">
                <Grid>
                    <TextBlock x:Name="TxtHint" FontSize="11" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="230" HorizontalAlignment="Left"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnLater" Content="稍后再说" Width="90"
                                Style="{StaticResource GhostButton}" Click="Later_Click" />
                        <Button x:Name="BtnDownload" Content="立即下载" Width="96" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}" Click="Download_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
